# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Vuoti di proposito: APP_SECRET, JWT_PASSPHRASE e APP_ENCRYPTION_KEY sono di ogni
# installazione e stanno in backend/.env.local (escluso da git). Li genera
# scripts/setup-sviluppo.sh; a mano: README, "Avvio (sviluppo)".
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> cartellaviva ###
# URL del frontend Flutter (link negli inviti: <FRONTEND_URL>/auth/invite?token=...)
FRONTEND_URL=http://localhost:5000
# Deep link dell'app mobile per il ritorno dall'OAuth di Google Drive (schema registrato in Android/iOS)
MOBILE_RETURN_URL=cartellaviva://import/esito
MAILER_FROM=no-reply@cartellaviva.local
# Chiave (32 byte base64) che cifra i segreti TOTP a riposo: va in backend/.env.local
# (o nell'ambiente) e non si cambia più, altrimenti i segreti diventano illeggibili.
APP_ENCRYPTION_KEY=
# Registrazione libera (1) o chiusa (0). Chiusa: nessuno crea un account da solo, né con
# email e password né con il primo accesso Google; si entra solo accettando un invito in
# famiglia o con un account creato dal portale. Su un server raggiungibile da internet: 0.
REGISTRAZIONE_APERTA=1
# Client ID OAuth di Google accettati come "aud" dell'ID token, separati da virgola
# (web, Android, iOS). Vuoto = accesso con Google disattivato.
GOOGLE_CLIENT_IDS=
# Cartella dei file dei documenti (volume Docker dedicato "document_storage").
DOCUMENT_STORAGE_DIR=/var/lib/cartellaviva/documents
# File con la MASTER KEY dei documenti sensibili: fuori dal DB, fuori dal codice,
# montato come Docker secret. Vedi docs/gestione-chiavi.md (backup obbligatorio).
APP_MASTER_KEY_FILE=/run/secrets/master_key
# Import da Google Drive (client OAuth "Applicazione web" della Google Cloud Console,
# con l'API Drive abilitata). Vuoti = import da Drive non disponibile ("provider non
# configurato"). Il redirect URI deve coincidere con quello registrato in Google:
# <URL pubblico dell'API>/api/import-sources/oauth/callback
# Il client secret NON va nei file versionati: mettilo in .env.local o nell'ambiente.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Classificazione automatica dei documenti importati, scadenze proposte e dati estratti
# dai documenti (Ollama locale, servizio "ollama").
# Modello consigliato: qwen3:4b-instruct-2507-q4_K_M. Vuoto = classificazione disattivata.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Ricerca per significato e documenti simili (solo documenti NON cifrati): modello di
# embedding multilingue di Ollama. Primo avvio: ollama pull bge-m3 (~1,2 GB).
# Vuoto = ricerca per significato disattivata (resta quella per parole).
OLLAMA_EMBED_MODEL=bge-m3
# Notifiche push (Firebase Cloud Messaging, API HTTP v1). Vuoti = push non configurate
# (restano le email). FIREBASE_CREDENTIALS è il PERCORSO del JSON del service account,
# montato come secret: mai il contenuto qui, mai nel repository.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
# Anteprima dei documenti Office (DOCX, XLSX, ODT...): convertitore Gotenberg nel
# servizio "convertitore" (rete interna). Vuoto = anteprima Office non disponibile
# ("convertitore non configurato"), i file restano caricabili e scaricabili.
GOTENBERG_URL=
###< cartellaviva ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://cartellaviva:cartellaviva@database:5432/cartellaviva?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
