{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_componenti.html.twig' as cv %}

{% block contenuto %}
<p>Ciao {{ nome }},</p>
<p>{% if totale == 1 %}nel portale delle idee è arrivata 1 nuova idea{% else %}nel portale delle idee sono arrivate {{ totale }} nuove idee{% endif %}:</p>
<ul style="margin: 0 0 16px; padding-left: 22px;">
<li>nuove funzionalità: <strong>{{ funzionalita }}</strong></li>
<li>miglioramenti: <strong>{{ miglioramenti }}</strong></li>
</ul>
{{ cv.bottone(url, 'Apri il portale delle idee') }}
{% endblock %}

{% block nota %}Per riservatezza il testo delle idee si legge solo nel portale.{% endblock %}
