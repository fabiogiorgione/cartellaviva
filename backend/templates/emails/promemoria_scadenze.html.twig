<!doctype html>
<html lang="it">
<body style="font-family: Arial, sans-serif; color: #313a46; line-height: 1.5;">
    <p>Ciao {{ nome }},</p>
    <p>{% if voci|length == 1 %}hai una scadenza in arrivo:{% else %}hai {{ voci|length }} scadenze in arrivo:{% endif %}</p>
    <ul>
        {% for voce in voci %}
            <li><strong>{{ voce.data|date('d/m/Y') }}</strong> — {{ voce.famiglia }}</li>
        {% endfor %}
    </ul>
    <p>
        <a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #0F5C4C; color: #fff; text-decoration: none; border-radius: 4px;">Apri lo scadenziario</a>
    </p>
    <p style="font-size: 13px; color: #6c757d;">
        Per riservatezza i dettagli delle scadenze si leggono solo nell'app.
    </p>
</body>
</html>
