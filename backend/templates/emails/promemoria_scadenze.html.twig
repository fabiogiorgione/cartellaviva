{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_componenti.html.twig' as cv %}

{% block contenuto %}
<p>Ciao {{ nome }},</p>
<p>{% if voci|length == 1 %}hai una scadenza in arrivo:{% else %}hai {{ voci|length }} scadenze in arrivo:{% endif %}</p>
<ul style="margin: 0 0 16px; padding-left: 22px;">
{% for voce in voci %}
<li><strong>{{ voce.data|date('d/m/Y') }}</strong> — {{ voce.famiglia }}</li>
{% endfor %}
</ul>
{{ cv.bottone(url, 'Apri lo scadenziario') }}
{% endblock %}

{% block nota %}Per riservatezza i dettagli delle scadenze si leggono solo nell'app.{% endblock %}
