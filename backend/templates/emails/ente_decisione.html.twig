<!doctype html>
<html lang="it">
<body style="font-family: Arial, sans-serif; color: #313a46; line-height: 1.5;">
    <p>Buongiorno,</p>
    {% if stato == 'verificato' %}
        <p><strong>{{ ente }}</strong> è verificato su CartellaViva: ora potete invitare le famiglie a collegarsi e inviare richieste.</p>
    {% elseif stato == 'integrazioni' %}
        <p>Per verificare <strong>{{ ente }}</strong> ci servono alcune integrazioni:</p>
        <p style="padding: 10px 14px; background: #f8f9fb; border-left: 3px solid #0F5C4C;">{{ nota }}</p>
        <p>Potete correggere i dati dal profilo dell'ente.</p>
    {% else %}
        <p>La registrazione di <strong>{{ ente }}</strong> non è stata approvata:</p>
        <p style="padding: 10px 14px; background: #f8f9fb; border-left: 3px solid #dc2626;">{{ nota }}</p>
    {% endif %}
    <p>
        <a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #0F5C4C; color: #fff; text-decoration: none; border-radius: 4px;">Apri l'area dell'ente</a>
    </p>
</body>
</html>
