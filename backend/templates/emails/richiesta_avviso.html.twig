{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_componenti.html.twig' as cv %}

{% block contenuto %}
<p>Ciao {{ nome }},</p>
{% if motivo == 'rifirma' %}
<p><strong>{{ ente }}</strong> ti chiede di correggere una risposta che hai inviato.</p>
{% elseif motivo == 'sollecito' %}
<p>hai ancora una richiesta da <strong>{{ ente }}</strong> a cui rispondere.</p>
{% else %}
<p>hai una nuova richiesta da <strong>{{ ente }}</strong>.</p>
{% endif %}
{{ cv.bottone(url, 'Apri le richieste') }}
{% endblock %}

{% block nota %}Per riservatezza i dettagli si leggono solo nell'app.{% endblock %}
