<!doctype html>
<html lang="it">
<body style="font-family: Arial, sans-serif; color: #313a46; line-height: 1.5;">
    <p>Ciao {{ nome }},</p>
    {% if motivo == 'rifirma' %}
        <p><strong>{{ ente }}</strong> ti chiede di correggere una risposta che hai inviato.</p>
    {% elseif motivo == 'sollecito' %}
        <p>hai ancora una richiesta da <strong>{{ ente }}</strong> a cui rispondere.</p>
    {% else %}
        <p>hai una nuova richiesta da <strong>{{ ente }}</strong>.</p>
    {% endif %}
    <p>
        <a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #0F5C4C; color: #fff; text-decoration: none; border-radius: 4px;">Apri le richieste</a>
    </p>
    <p style="font-size: 13px; color: #6c757d;">
        Per riservatezza i dettagli si leggono solo nell'app.
    </p>
</body>
</html>
