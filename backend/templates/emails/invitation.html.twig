<!doctype html>
<html lang="it">
<body style="font-family: Arial, sans-serif; color: #313a46; line-height: 1.5;">
    <p>Ciao,</p>
    <p><strong>{{ inviter }}</strong> ti ha invitato a entrare in <strong>{{ tenantName }}</strong> su CartellaViva con il ruolo <strong>{{ roleName }}</strong>.</p>
    <p>
        <a href="{{ acceptUrl }}" style="display: inline-block; padding: 10px 18px; background: #0F5C4C; color: #fff; text-decoration: none; border-radius: 4px;">Accetta l'invito</a>
    </p>
    <p style="font-size: 13px; color: #6c757d;">
        Il link scade il {{ expiresAt|date('d/m/Y \\a\\l\\l\\e H:i') }}.<br>
        Se non ti aspettavi questo invito puoi ignorare questa email.
    </p>
</body>
</html>
