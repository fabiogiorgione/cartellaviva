{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_componenti.html.twig' as cv %}

{% block contenuto %}
<p>Ciao,</p>
<p><strong>{{ inviter }}</strong> ti ha invitato a entrare in <strong>{{ tenantName }}</strong> su CartellaViva con il ruolo <strong>{{ roleName }}</strong>.</p>
{{ cv.bottone(acceptUrl, 'Accetta l\'invito') }}
{% endblock %}

{% block nota %}Il link scade il {{ expiresAt|date('d/m/Y \\a\\l\\l\\e H:i') }}. Se non ti aspettavi questo invito puoi ignorare questa email.{% endblock %}

{% block perche %}Ricevi questa email perché {{ inviter }} ha invitato questo indirizzo su CartellaViva.{% endblock %}
