{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_componenti.html.twig' as cv %}

{% block contenuto %}
<p>Ciao {{ nome }},</p>
<p>{{ da }} ha annullato l'eliminazione {{ ente|default(false) ? 'dell\'ente' : 'della famiglia' }} <strong>{{ famiglia }}</strong>: tutto torna come prima.</p>
<p>Se usavate Google Drive, va ricollegato dalle impostazioni.</p>
{{ cv.bottone(url, ente|default(false) ? 'Apri l\'area dell\'ente' : 'Apri le impostazioni della famiglia') }}
{% endblock %}
